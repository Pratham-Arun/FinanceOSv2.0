MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=expense_reimbursement
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PORT=8000

# Groq LLM — get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (optional fallback) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Tesseract OCR — Windows path (UB-Mannheim installer default)
# Install: winget install UB-Mannheim.TesseractOCR
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# CORS — comma-separated list of allowed frontend origins.
# Development default (set automatically if this var is absent):
#   http://localhost:3000,http://localhost:5173
# Production example:
#   ALLOWED_ORIGINS=https://app.financeos.com,https://admin.financeos.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
